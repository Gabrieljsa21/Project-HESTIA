# Todas as variáveis abaixo são opcionais - cada uma liga um módulo
# independente do HESTIA (lançamentos/atividade/conquistas). Copie os valores
# reais do `.env` da GAIA (as mesmas 4 chaves de Steam existiam lá antes desta
# extração, 2026-08-24) - não precisa gerar nada de novo.

# Sessão de login da Steam (opcional) - usada só pra monitorar sua página de
# atividade (steamcommunity.com/id/.../home - conquistas, anúncios dos seus
# jogos, compra/wishlist de amigos) e avisar quando algo novo aparecer. É o
# cookie "steamLoginSecure" da sua sessão logada no navegador: abra
# steamcommunity.com logado -> F12 -> aba "Application" (Chrome/Edge) ou
# "Armazenamento" (Firefox) -> "Cookies" -> clique em
# "https://steamcommunity.com" -> ache a linha "steamLoginSecure" -> copie o
# valor da coluna "Value" - equivale a estar logado como você na Steam, trate
# como senha. Sem isso, o monitoramento de atividade fica desligado.
STEAM_LOGIN_SECURE=
# URL da sua página de atividade (perfil -> aba "Início"/"Home").
STEAM_PERFIL_URL=

# SteamID64 (opcional) - usado pro Assistente de Lançamentos ler sua wishlist
# via API oficial (sem chave nenhuma). Não é segredo (é público, dá pra ver no
# seu perfil) - sem ele, cai num fallback mais lento que extrai da sessão
# logada (STEAM_LOGIN_SECURE).
STEAM_ID64=

# Chave da Web API da Steam (opcional) - usada pelo Assistente de Conquistas
# pra ler SEU progresso real de conquistas num jogo. Gere de graça em
# steamcommunity.com/dev/apikey (logado, qualquer "nome de domínio" serve, ex.
# "localhost") - trate como senha, dá acesso a dados da sua conta. Sem isso, a
# tag <CONQUISTAS> fica desligada (avisa que não está configurada).
STEAM_WEBAPI_KEY=

# Onde avisar a GAIA pra sincronizar um lançamento com o Google Calendar
# dedicado "Lançamentos Steam" - o HESTIA nunca fala com o Google Calendar
# direto (evita duplicar OAuth só pra isso), avisa por webhook e é a GAIA quem
# tem a credencial de verdade. Ajuste só se a GAIA rodar noutra porta/máquina.
GAIA_WEBHOOK_URL=http://127.0.0.1:8766/hestia/sincronizar_lancamento
